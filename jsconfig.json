{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noImplicitAny": false,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM"]
	},
	"include": ["**/*.js", "**/*.mjs"],
	"exclude": ["libraries.bundle.js", "node_modules", "vendors"]
}

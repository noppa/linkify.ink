{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noImplicitAny": false,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM"]
	},
	"include": [
		"linkify.ink.js",
		"lib/**/*.js",
		"lib/**/*.mjs",
		"components/**/*.js",
		"components/**/*.mjs"
	],
	"exclude": [
		"libraries.bundle.js",
		"vendor.codec.bundle.js",
		"node_modules",
		"vendors"
	]
}

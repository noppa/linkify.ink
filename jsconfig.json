{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noImplicitAny": false,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM"],
		"types": ["chrome"]
	},
	"include": [
		"linkify.ink.js",
		"vendor/vendor.readability.bundle.d.ts",
		"lib/**/*.js",
		"lib/**/*.mjs",
		"components/**/*.js",
		"components/**/*.mjs",
		"extension/**/*.js",
		"extension/**/*.d.ts"
	],
	"exclude": [
		"libraries.bundle.js",
		"vendor/vendor.codec.bundle.js",
		"vendor/vendor.readability.bundle.js",
		"extension/vendor",
		"node_modules",
		"vendors"
	]
}
